---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const groups: { id: string; h: string; qs: { q: string; a: string }[] }[] = [
  {
    id: "shipping",
    h: "Shipping",
    qs: [
      { q: "How much is shipping?", a: "Bikes and framesets ship free. Accessories ship at a flat rate: courier €7 or Box NOW locker €1 within Greece, courier €12 internationally." },
      { q: "Where do orders ship from?", a: "Every order ships from our workshop in Patras, Greece." },
      { q: "When will my DRYAD arrive?", a: "The DRYAD is on pre-order. First deliveries are planned from December 2026; we confirm your date when your build is scheduled." },
    ],
  },
  {
    id: "ordering",
    h: "Ordering",
    qs: [
      { q: "How does the DRYAD pre-order work?", a: "A €400 deposit reserves your frame slot and locks the pre-order price. We confirm size and build with you before machining starts. You pay the balance when your bike is finished." },
      { q: "Which KOMPace options are there?", a: "Frameset, complete bike or the MY2026 Special Edition, in sizes S1 to S3. Black anodising is standard; coloured anodising is €300 more." },
      { q: "Can I return or change my order?", a: "Bikes and framesets are machined for each order, so we can't take them back or exchange them for another size, colour or model. Ask us anything before you order and we'll help you choose." },
    ],
  },
  {
    id: "warranty",
    h: "Warranty and crash replacement",
    qs: [
      { q: "What does the warranty cover?", a: "Five years from the date of purchase on frames, swingarms, rails and every other frame part we manufacture, for the first owner of a bike or frameset bought from APER or an authorised reseller. If a defect is covered, we repair it or replace the part with an equivalent one, which may differ in colour." },
      { q: "What isn't covered?", a: "Components from other brands (covered by their own manufacturers), normal wear, crash damage, incorrect assembly or maintenance, incompatible parts, cosmetic marks and rental use." },
      { q: "What is crash replacement?", a: "A hard crash can damage a frame in ways that make it unsafe. For five years after purchase, we replace a damaged APER frame component at 35% off its price at the time you ask. The colour may differ; the part is fully functional and safe." },
      { q: "How do I make a claim?", a: "Email info@aper-bikes.com with your order details, a description and photos. Please inspect your bike when it arrives and tell us about any visible defect straight away." },
    ],
  },
  {
    id: "care",
    h: "Care and parts",
    qs: [
      { q: "How should I look after my bike?", a: "Clean the frame after riding. On the KOMPace, lubricate the Rising Pivot rail after every ride and every wash: a dry rail wears faster. For adjustments, visit a specialist workshop or ask us." },
      { q: "Where can I get spare parts?", a: "Thru axles, hangers, idlers, pulleys, rail bearings and protection kits are in our accessories shop." },
    ],
  },
];
---

<Layout title="Support" description="Shipping, ordering, warranty, crash replacement and care for APER bikes." page="support">
  <section class="light sup">
    <div class="wrap">
      <header class="sup-head">
        <h1>Support</h1>
        <p class="lead muted">Answers from the people who designed and machined your bike.</p>
      </header>
      <div class="sup-grid">
        <div class="faq">
          {groups.map((g) => (
            <section class="grp" id={g.id} aria-labelledby={`${g.id}-h`}>
              <h2 id={`${g.id}-h`}>{g.h}</h2>
              {g.qs.map((x) => (
                <details>
                  <summary>{x.q}</summary>
                  <p>{x.a}</p>
                </details>
              ))}
            </section>
          ))}
          <p class="small muted parts">Looking for a part? <a class="link more" href={`${base}accessories/`}>Accessories and spares</a></p>
        </div>
        <aside class="contact" id="contact-us" aria-labelledby="ct-h">
          <h2 id="ct-h">Contact</h2>
          <p>We answer ourselves, usually within one working day.</p>
          <dl>
            <div><dt>Email</dt><dd><a class="link" href="mailto:info@aper-bikes.com">info@aper-bikes.com</a></dd></div>
            <div><dt>Phone</dt><dd><a class="link" href="tel:+306940895867">+30 694 089 5867</a><br /><span class="muted">Weekdays 8:00–16:00 CET</span></dd></div>
            <div><dt>Workshop</dt><dd>Panachaikou 96<br />26442 Patras, Greece</dd></div>
          </dl>
          <a class="btn btn-solid" href="mailto:info@aper-bikes.com?subject=Support%20request">Email us</a>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sup {
    padding-block: clamp(48px, 6vw, 96px) var(--section);
  }
  .sup-head {
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .sup-head h1 {
    margin-bottom: 12px;
  }
  .sup-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(260px, 1fr);
    gap: clamp(40px, 7vw, 128px);
    align-items: start;
  }
  .grp {
    margin-bottom: 48px;
  }
  .grp h2 {
    font-size: 0.875rem;
    letter-spacing: 0;
    font-weight: 600;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--gold);
    display: inline-block;
    margin-bottom: 4px;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 40px 20px 0;
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "";
    position: absolute;
    right: 6px;
    top: 50%;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    transition: transform var(--t-ui) var(--ease-out);
  }
  details[open] summary::after {
    transform: translateY(-30%) rotate(-135deg);
  }
  summary:hover {
    color: #000;
  }
  details p {
    color: var(--muted);
    margin: -4px 0 22px;
    max-width: 62ch;
  }
  details[open] p {
    animation: open 260ms var(--ease-out);
  }
  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .parts {
    margin-top: 8px;
  }
  .contact {
    position: sticky;
    top: calc(var(--bar-h) + 32px);
    border-left: 2px solid var(--gold);
    padding-left: clamp(20px, 2.5vw, 36px);
  }
  .contact h2 {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }
  .contact > p {
    color: var(--muted);
  }
  .contact dl {
    margin: 20px 0 24px;
  }
  .contact dl div {
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }
  .contact dt {
    font-size: 0.8125rem;
    color: var(--muted);
    margin-bottom: 2px;
  }
  .contact dd {
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    details[open] p {
      animation: none;
    }
  }
  @media (max-width: 860px) {
    .sup-grid {
      grid-template-columns: 1fr;
    }
    .contact {
      position: static;
      order: -1;
    }
  }
</style>
