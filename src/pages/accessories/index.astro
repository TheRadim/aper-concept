---
import Layout from "../../layouts/Layout.astro";
import { accessories } from "../../data/accessories";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const eur = (n: number) => "€" + n.toLocaleString("en-GB");
const filters = ["All", "DRYAD", "KOMPace", "Protection", "Apparel"];
---

<Layout title="Accessories and spares" description="APER spare parts, protection and apparel, machined and made in Patras." page="accessories">
  <section class="acc-head light">
    <div class="wrap">
      <h1>Accessories</h1>
      <p class="lead muted">Spares, protection and finishing parts, most of them machined on the same mills as our frames.</p>
    </div>
  </section>

  <section class="light acc-shop" aria-label="Products" data-shop>
    <div class="wrap">
      <div class="toolbar">
        <div class="chips" role="group" aria-label="Filter">
          {filters.map((f, i) => <button class="chip" type="button" data-f={f} aria-pressed={i === 0 ? "true" : "false"}>{f}</button>)}
        </div>
        <div class="tool-right">
          <span class="small muted" data-count>{accessories.length} products</span>
          <label class="small sort">Sort by
            <select data-sort>
              <option value="featured">Featured</option>
              <option value="low">Price: low to high</option>
              <option value="high">Price: high to low</option>
            </select>
          </label>
        </div>
      </div>
      <div class="acc-grid" data-grid>
        {accessories.map((a, i) => (
          <a class="card acc-card" href={`${base}accessories/${a.slug}/`} data-tags={a.tags.join(",")} data-price={a.price} data-order={i}>
            <figure class="acc-photo"><img src={a.img} alt={a.name} loading="lazy" /></figure>
            <div class="card-body">
              {a.options.some((o) => o.kind === "colour") && <span class="swatches" aria-label="Available in five anodised colours"><i style="background:#1d1d1f"></i><i style="background:#8a1f5c"></i><i style="background:#1f4f9c"></i><i style="background:#c9cbcd"></i><i style="background:#c0262d"></i></span>}
              <h3>{a.name}</h3>
              <p class="small muted fits">{a.cat === "Apparel" ? "Apparel" : `Fits ${a.fits}`}</p>
              <p class="card-price num">{eur(a.price)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .acc-head {
    padding-block: clamp(48px, 6vw, 88px) 32px;
    text-align: center;
  }
  .acc-head h1 {
    margin-bottom: 14px;
  }
  .acc-head .lead {
    margin-inline: auto;
  }
  .acc-shop {
    padding-bottom: var(--section);
  }
  .toolbar {
    position: sticky;
    top: var(--bar-h);
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px 16px;
    flex-wrap: wrap;
    padding: 14px 0;
    margin-bottom: 12px;
    background: rgb(255 255 255 / 0.85);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    transition: top var(--t-sheet) var(--spring);
  }
  :global(html[data-bar-hidden="true"]) .toolbar {
    top: 0;
  }
  .tool-right {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .sort select {
    margin-left: 6px;
    border: 0;
    background: var(--paper-2);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 0.875rem;
  }
  .acc-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .acc-photo {
    margin: 0;
    aspect-ratio: 1 / 1;
    background: #fff;
    margin: 10px 10px 0;
    border-radius: var(--radius-s);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .acc-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 600ms var(--spring);
  }
  .acc-card:hover .acc-photo img {
    transform: scale(1.04);
  }
  .fits {
    margin: 0;
  }
  .swatches {
    display: flex;
    gap: 5px;
    margin-bottom: 6px;
  }
  .swatches i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  @media (max-width: 1060px) {
    .acc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .acc-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .acc-grid h3 {
      font-size: 0.9375rem;
    }
    .acc-card .card-body {
      padding: 12px 12px 16px;
    }
    .tool-right {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<script>
  const shop = document.querySelector<HTMLElement>("[data-shop]");
  if (shop) {
    const chips = [...shop.querySelectorAll<HTMLButtonElement>("[data-f]")];
    const grid = shop.querySelector<HTMLElement>("[data-grid]")!;
    const cards = [...grid.querySelectorAll<HTMLElement>(".card")];
    const count = shop.querySelector<HTMLElement>("[data-count]")!;
    const sort = shop.querySelector<HTMLSelectElement>("[data-sort]")!;
    let f = "All";
    const apply = () => {
      let n = 0;
      cards.forEach((c) => {
        const show = f === "All" || c.dataset.tags!.split(",").includes(f);
        c.hidden = !show;
        if (show) n++;
      });
      count.textContent = `${n} product${n === 1 ? "" : "s"}`;
      const key = sort.value;
      [...cards]
        .sort((a, b) => (key === "low" ? +a.dataset.price! - +b.dataset.price! : key === "high" ? +b.dataset.price! - +a.dataset.price! : +a.dataset.order! - +b.dataset.order!))
        .forEach((c) => grid.appendChild(c));
    };
    chips.forEach((c) => c.addEventListener("click", () => { f = c.dataset.f!; chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c))); apply(); }));
    sort.addEventListener("change", apply);
  }
</script>
