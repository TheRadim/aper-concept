---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import { pocket } from "../lib/bike";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// Schematic: one tube segment at four stages.
const seg = (stage: number) => {
  const W = 320, H = 120, n = 6;
  let d = "";
  if (stage < 2) return d;
  for (let i = 0; i < n; i++) {
    const x = 8 + i * ((W - 16) / n) * 0.98;
    const w = (W - 16) / n + 26;
    const up = i % 2 === 0;
    const depth = stage === 2 ? 0.55 : 1;
    const y0 = up ? H - 14 : 14, y1 = up ? H - 14 - (H - 28) * depth : 14 + (H - 28) * depth;
    d += pocket([x, y0], [x + w, y0], [x + w / 2, y1], stage === 3 ? 7 : 3);
  }
  return d;
};
const stages = [
  { name: "Profile", text: "Closed-section 7075-T6 extrusion, cut to length." },
  { name: "Roughed", text: "Outer shape milled, first pockets opened." },
  { name: "Ribbed", text: "Ribs, variable walls and undercuts cut to depth." },
  { name: "Finished", text: "Edges and corners finished, ready to join." },
];
const steps = [
  { img: "framePurple", pos: "50% 55%", alt: "Anodised KOMPace frame, studio", h: "Design", p: "Each member is modelled around how it is loaded on a heavy, rough ride, not around a target weight.", shot: "Model on screen beside the matching part on the bench.", verify: true },
  { img: "dryadWorkshop", pos: "50% 18%", alt: "APER's vertical machining centre", h: "Programming", p: "The engineers who design a part also write its toolpaths. A change to a rib goes from model to machine in the same room.", shot: "CAM toolpath simulation on screen.", verify: true },
  { img: "dryadOnMill", pos: "50% 60%", alt: "Machined DRYAD frame on the mill table", h: "Machining", p: "Ribs, varying walls and deep undercuts are cut from the profile. Every inside corner keeps the radius of the cutter.", shot: "Spindle mid-cut, coolant and chips." },
  { img: "frameGold", pos: "50% 55%", alt: "Anodised gold KOMPace frame, studio", h: "Joining", p: "Members meet through machined, interlocking interfaces, then are structurally bonded and mechanically fastened.", shot: "Interlocking joint before bonding." },
  { img: "dryadWorkshop", pos: "50% 72%", alt: "Assembled DRYAD in the workshop", h: "Assembly", p: "Frame, one-piece fork and bushing seatstays are assembled and checked in the same workshop, then built to your specification.", shot: "A DRYAD on the assembly stand." },
];
---

<Layout title="Engineering" description="How APER machines bicycle frames from 7075-T6 aluminium in Patras. Concept page." page="engineering">
  <section class="e-hero dark" aria-labelledby="eh-h">
    <Photo img="dryadWorkshop" alt="DRYAD in front of APER's machining centre in Patras" shot="Workshop overview: machining centre, profile stock, a finished frame." ratio="auto" pos="50% 32%" class="e-photo" eager />
    <div class="e-scrim" aria-hidden="true"></div>
    <div class="wrap e-in" data-reveal>
      <h1 id="eh-h">From profile to frame</h1>
      <p class="lead">How APER turns an aluminium extrusion into a bicycle, in one workshop in Patras.</p>
    </div>
  </section>

  <section class="section light" aria-labelledby="seq-h">
    <div class="wrap">
      <div class="head-row">
        <h2 id="seq-h">One tube, four stages</h2>
        <p>Schematic sequence of a down tube section.<span class="verify" title="Stage order inferred from APER's descriptions" /></p>
      </div>
      <ol class="segs">
        {stages.map((s, i) => (
          <li>
            <svg viewBox="0 0 320 120" role="img" aria-label={`Schematic: tube segment, ${s.name.toLowerCase()}`}>
              <rect width="320" height="120" fill={i === 0 ? "#c9cbc7" : "#b9bbb7"} />
              <path d={seg(i)} fill="var(--paper)" />
            </svg>
            <h3>{s.name}</h3>
            <p class="muted small">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section light alt" aria-labelledby="st-h">
    <div class="wrap">
      <div class="head-row"><h2 id="st-h">The process</h2></div>
      {steps.map((s, i) => (
        <article class:list={["estep", i % 2 === 1 && "flip"]} data-reveal>
          <Photo img={s.img as any} alt={s.alt} shot={s.shot} ratio="3 / 2" pos={s.pos} />
          <div>
            <h3>{s.h}</h3>
            <p class="muted">{s.p}{s.verify && <span class="verify" title="To be confirmed by APER" />}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section dark" aria-labelledby="ho-h">
    <div class="wrap honest">
      <div>
        <h2 id="ho-h">What machining is not for</h2>
        <p class="muted">Good engineering includes saying what a method doesn't promise.</p>
      </div>
      <dl class="rules">
        <div><dt>The lightest frame</dt><dd class="muted">The DRYAD puts structural integrity and durability ahead of the lowest weight. A carbon race frame will weigh less.</dd></div>
        <div><dt>The cheapest method</dt><dd class="muted">Machining removes much of the profile it starts from. What it buys is control over where walls and ribs go.</dd></div>
        <div><dt>Per-rider tuning</dt><dd class="muted">Rib design shapes how a member flexes, but every size is designed and tested, not customised per rider.<span class="verify" title="Check how APER wants to describe this" /></dd></div>
        <div><dt>Testing</dt><dd class="muted">Which standards each frame and fork pass belongs here.<span class="verify" title="Needs APER's test data" /></dd></div>
      </dl>
    </div>
  </section>

  <section class="section light" aria-labelledby="cta-h">
    <div class="wrap cta">
      <h2 id="cta-h">See it on a bike</h2>
      <div class="cta-actions">
        <a class="btn btn-solid" href={`${base}dryad/`}>DRYAD</a>
        <a class="btn btn-line" href={`${base}kompace/`}>KOMPace</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .e-hero {
    position: relative;
    min-height: 70svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .e-hero :global(.e-photo) {
    position: absolute;
    inset: 0;
  }
  .e-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 11 12 / 0.85), rgb(10 11 12 / 0.2) 65%);
  }
  .e-in {
    position: relative;
    padding-block: 120px 72px;
  }
  .e-in h1 {
    margin-bottom: 16px;
  }
  .segs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .segs svg {
    width: 100%;
    height: auto;
    margin-bottom: 16px;
  }
  .segs h3 {
    margin-bottom: 4px;
  }
  .estep {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    margin-bottom: 64px;
  }
  .estep:last-child {
    margin-bottom: 0;
  }
  .estep.flip {
    grid-template-columns: 5fr 7fr;
  }
  .estep.flip > :first-child {
    order: 2;
  }
  .estep h3 {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    margin-bottom: 12px;
  }
  .honest {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 6vw, 112px);
  }
  .honest h2 {
    margin-bottom: 16px;
  }
  .honest dl {
    margin: 0;
  }
  .honest dl > div {
    border-bottom: 1px solid var(--line);
    padding: 18px 0;
  }
  .honest dt {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .honest dd {
    margin: 0;
  }
  .cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cta-actions {
    display: flex;
    gap: 12px;
  }
  @media (max-width: 860px) {
    .segs {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }
    .estep,
    .estep.flip,
    .honest {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .estep.flip > :first-child {
      order: 0;
    }
  }
</style>
