---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
const rows: [string, string][] = [
  ["Use", "Enduro"],
  ["Travel", "170 mm front / 160 mm rear"],
  ["Wheels", "29 in"],
  ["Suspension", "Rising Pivot (patented): sliding lower shock mount on a rail"],
  ["Rear axle path", "Up to 45 mm rearward (APER figure)"],
  ["Frame", "CNC-machined 7075 aluminium"],
  ["Sizes", "S1, S2, S3"],
  ["Frameset", "from €3,969"],
  ["Complete bike", "from €7,769"],
  ["MY2026 Special Edition", "€12,969"],
  ["Coloured anodising", "+€300"],
];
---

<Layout title="KOMPace" description="APER KOMPace enduro bike with Rising Pivot suspension. Concept outline." page="kompace">
  <section class="section light">
    <div class="wrap k-grid">
      <Photo shot="KOMPace studio profile, drive side." ratio="4 / 5" pos="40% 70%" eager />
      <div>
        <p class="small muted">Bikes / Enduro</p>
        <h1>KOMPace</h1>
        <p class="lead">APER's first bike: a 29-inch enduro frame built around the Rising Pivot, the suspension that started the company.</p>
        <div class="table-wrap">
          <table><tbody>{rows.map(([a, b]) => <tr><th scope="row">{a}</th><td>{b}</td></tr>)}</tbody></table>
        </div>
        <p class="small muted">Outline page. In the full site it uses the same product layout as the DRYAD. Maintenance: lubricate the Rising Pivot rail after every ride or wash.</p>
        <a class="btn btn-solid" href="https://aper-bikes.com/kompace/">Current KOMPace page</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .k-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  h1 {
    margin-bottom: 14px;
  }
  .table-wrap {
    margin: 24px 0 16px;
  }
  @media (max-width: 860px) {
    .k-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
