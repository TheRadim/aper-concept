---
import Photo from "./Photo.astro";
import type { Bike } from "../data/catalog";
import { eur } from "../data/dryad";
interface Props { bike: Bike }
const { bike } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const groups = ["All", ...new Set(bike.builds.map((b) => b.group))];
---

<section class="section light" id="builds" aria-labelledby="builds-h">
  <div class="wrap" data-filter-root>
    <div class="head-row">
      <h2 id="builds-h">{bike.name} builds</h2>
      <p>{bike.builds.length} options. Every build shares the same machined frame{bike.slug === "dryad" ? " and one-piece fork" : ""}.</p>
    </div>
    {groups.length > 2 && (
      <div class="chips" role="group" aria-label="Filter builds">
        {groups.map((g, i) => <button class="chip" type="button" data-filter={g} aria-pressed={i === 0 ? "true" : "false"}>{g}</button>)}
      </div>
    )}
    <div class="grid-cards">
      {bike.builds.map((b) => (
        <a class="card" href={`${base}${bike.slug}/${b.id}/`} data-group={b.group}>
          <span class="card-badge">{b.status}</span>
          <Photo img={b.img} alt={b.name} shot={`${b.name}, studio profile`} ratio="4 / 3" pos={b.pos} />
          <div class="card-body">
            <h3>{b.name}</h3>
            <ul>{b.bullets.map((x) => <li>{x}</li>)}</ul>
            <p class="card-price num">{eur(b.price)}{b.was && <s>{eur(b.was)}</s>}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-filter-root]").forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const cards = [...root.querySelectorAll<HTMLElement>("[data-group]")];
    chips.forEach((c) =>
      c.addEventListener("click", () => {
        const f = c.dataset.filter!;
        chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c)));
        cards.forEach((card) => (card.hidden = f !== "All" && card.dataset.group !== f));
      }),
    );
  });
</script>
